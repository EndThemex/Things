{
  "name": "things",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,green \"bun run dev:server\" \"bun run dev:web\"",
    "dev:server": "bun run --filter './apps/server' dev",
    "dev:web": "bun run --filter './apps/web' dev",
    "build": "bun run --filter './apps/web' build",
    "start": "bun run --filter './apps/server' start",
    "prod": "bun run build && bun run start",
    "db:migrate": "bun run --filter './apps/server' db:migrate"
  },
  "devDependencies": {
    "concurrently": "^10.0.6"
  }
}